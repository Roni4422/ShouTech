<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(DatabaseOnly)' != 'true'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(DatabaseOnly)' == 'true'">net8.0</TargetFramework>
    <UseWPF Condition="'$(DatabaseOnly)' != 'true'">true</UseWPF>
    <EnableWindowsTargeting Condition="'$(DatabaseOnly)' != 'true'">true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5" />
  </ItemGroup>
  <ItemGroup>
    <!-- Phase 4: the svc webhook signer is a standalone file; compile it
         directly so its HMAC vectors are covered by this test project. -->
    <Compile Include="..\..\svc\WebhookSigner.cs" Link="WebhookSigner.cs" Condition="'$(DatabaseOnly)' != 'true'" />
    <Compile Remove="**\*.cs" Condition="'$(DatabaseOnly)' == 'true'" />
    <Compile Include="OperationsServiceTests.cs" Condition="'$(DatabaseOnly)' == 'true'" />
    <Compile Include="MaintTests.cs" Condition="'$(DatabaseOnly)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ShouTech.ERP.csproj" Condition="'$(DatabaseOnly)' != 'true'" />
    <ProjectReference Include="..\..\src\App\App.csproj" Condition="'$(DatabaseOnly)' == 'true'" />
    <ProjectReference Include="..\..\src\Infra\Infra.csproj" />
    <ProjectReference Include="..\..\tools\SqlMigrator\SqlMigrator.csproj" ReferenceOutputAssembly="false" Condition="'$(DatabaseOnly)' != 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(DatabaseOnly)' != 'true'">
    <None Include="..\..\app\Resources\COA\**\*" Link="Resources\COA\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\app\Resources\Currencies\**\*" Link="Resources\Currencies\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopySqlMigratorForIntegrationTests" AfterTargets="Build" Condition="'$(DatabaseOnly)' != 'true'">
    <ItemGroup>
      <SqlMigratorOutput Include="$(MSBuildProjectDirectory)\..\..\tools\SqlMigrator\bin\$(Configuration)\net8.0\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(SqlMigratorOutput)"
      DestinationFiles="@(SqlMigratorOutput->'$(OutDir)tools\SqlMigrator\bin\$(Configuration)\net8.0\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
