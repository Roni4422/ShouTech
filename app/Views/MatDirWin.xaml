<local:BaseWin x:Class="ShouTech.App.Views.MatDirWin"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShouTech.App.Views"
     xmlns:loc="clr-namespace:ShouTech.App.Localization"
     loc:LocProps.WindowKey="Inventory.MaterialTree"
     Title="Material Directory"
     Width="400" Height="590"
     MinWidth="380" MinHeight="360"
     WindowStartupLocation="CenterOwner"
     Background="{DynamicResource BackgroundBrush}"
     Foreground="{DynamicResource TextBrush}"
     FontFamily="{DynamicResource ApplicationFontFamily}"
     FontSize="{DynamicResource FontSize12}"
     ResizeMode="CanResizeWithGrip">


<Window.Resources>

    <Style x:Key="ToolbarButton"
           TargetType="Button">

        <Setter Property="MinWidth"
                Value="58"/>

        <Setter Property="Height"
                Value="28"/>

        <Setter Property="Margin"
                Value="2,0"/>

        <Setter Property="Padding"
                Value="8,0"/>

        <Setter Property="FontSize"
                Value="{DynamicResource FontSize12}"/>

        <Setter Property="VerticalContentAlignment"
                Value="Center"/>

        <Setter Property="HorizontalContentAlignment"
                Value="Center"/>

        <Setter Property="Background"
                Value="{DynamicResource SurfaceBrush}"/>

        <Setter Property="Foreground"
                Value="{DynamicResource TextBrush}"/>

        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrush}"/>

        <Setter Property="BorderThickness"
                Value="1"/>

    </Style>

    <Style x:Key="SearchButton"
           TargetType="Button"
           BasedOn="{StaticResource ToolbarButton}">

        <Setter Property="MinWidth"
                Value="58"/>

        <Setter Property="Width"
                Value="58"/>

    </Style>

    <Style TargetType="TreeViewItem">

        <Setter Property="Padding"
                Value="2,3"/>

        <Setter Property="IsExpanded"
                Value="{Binding IsExpanded, Mode=TwoWay}"/>

    </Style>

</Window.Resources>

<Grid>

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Mode and search -->
    <Border Grid.Row="0"
            Padding="8,7"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtSearch"
                     Grid.Column="0"
                    
                     VerticalContentAlignment="Center"
                     Padding="7,0"
                     Margin="0,0,5,0"
                     Background="{DynamicResource BackgroundBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     Foreground="{DynamicResource TextBrush}"
                     TextChanged="TxtSearch_TextChanged"/>

            <Button x:Name="BtnSearch"
                    Grid.Column="1"
                    Style="{StaticResource SearchButton}"
                    Content="Search"
                    loc:LocProps.Key="Buttons.Search"
                    Click="Search_Click"/>

        </Grid>

    </Border>

    <!-- Action bar (bottom, layout rule) -->
    <Border Grid.Row="3"
            Padding="6,5"
            Background="Transparent"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">

        <StackPanel Orientation="Horizontal" local:FlowAlign.AlignEnd="True">

            <Button x:Name="BtnAdd"
                    Style="{StaticResource ToolbarButton}"
                    Content="New"
                    loc:LocProps.Key="Common.New"
                    Click="Add_Click"/>

            <Button x:Name="BtnRemove"
                    Style="{StaticResource ToolbarButton}"
                    Content="Delete"
                    loc:LocProps.Key="Buttons.Delete"
                    Click="Remove_Click"/>

            <Button x:Name="BtnRefresh"
                    Style="{StaticResource ToolbarButton}"
                    Content="Refresh"
                    loc:LocProps.Key="Buttons.Refresh"
                    Click="Refresh_Click"/>

            <Button x:Name="BtnPrint"
                    Style="{StaticResource ToolbarButton}"
                    Content="Print"
                    loc:LocProps.Key="Buttons.Print"
                    Click="Print_Click"/>

            

        </StackPanel>

    </Border>

    <!-- Material directory TREE (owner grid spec item 6): groups
         (categories) are folder nodes — modern Segoe MDL2 folder
         glyphs, open when expanded / closed when collapsed —
         materials are their children; a group may be empty and a
         material with no group sits at the root. -->
    <TreeView x:Name="TvItems"
              Grid.Row="2"
              BorderThickness="0"
              Background="{DynamicResource BackgroundBrush}"
              Foreground="{DynamicResource TextBrush}"
              MouseDoubleClick="Tv_DoubleClick"
              KeyDown="Tv_KeyDown">

        <TreeView.Resources>
            <HierarchicalDataTemplate DataType="{x:Type local:MatDirNode}"
                                      ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="NodeGlyph"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Text="&#xE8B7;"/>
                    <TextBlock Text="{Binding Item.Code}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Item.DisplayName}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Item.StatusLabel}"
                               Margin="8,0,0,0"
                               Opacity="0.65"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <HierarchicalDataTemplate.Triggers>
                    <!-- Open folder while the group node is expanded. -->
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                        <Setter TargetName="NodeGlyph" Property="Text" Value="&#xE838;"/>
                    </DataTrigger>
                    <!-- Materials are documents, not folders. -->
                    <DataTrigger Binding="{Binding IsGroup}" Value="False">
                        <Setter TargetName="NodeGlyph" Property="Text" Value="&#xE8A5;"/>
                    </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>
        </TreeView.Resources>

        <TreeView.ContextMenu>

            <ContextMenu x:Name="ItemsContextMenu"
                         Opened="Ctx_Opened">

                <MenuItem x:Name="CtxOpen"
                          Header="Open Card"
                          loc:LocProps.Key="Inventory.MaterialTreeTexts.OpenCard"
                          Click="Open_Click"
                          InputGestureText="Enter"/>

                <MenuItem x:Name="CtxNew"
                          Header="New"
                          loc:LocProps.Key="Common.New"
                          Click="Add_Click"
                          InputGestureText="Ins"/>

                <MenuItem x:Name="CtxEdit"
                          Header="Edit"
                          loc:LocProps.Key="Buttons.Edit"
                          Click="Edit_Click"/>

                <Separator/>

                <MenuItem x:Name="CtxDelete"
                          Header="Delete"
                          loc:LocProps.Key="Buttons.Delete"
                          Click="Remove_Click"
                          InputGestureText="Del"/>

                <Separator/>

                <MenuItem x:Name="CtxCopyCode"
                          Header="Copy Code"
                          loc:LocProps.Key="Inventory.MaterialTreeTexts.CopyCode"
                          Click="CopyCode_Click"/>

                <MenuItem x:Name="CtxCopyName"
                          Header="Copy Name"
                          loc:LocProps.Key="Inventory.MaterialTreeTexts.CopyName"
                          Click="CopyName_Click"/>

                <Separator/>

                <MenuItem x:Name="CtxRefresh"
                          Header="Refresh"
                          loc:LocProps.Key="Buttons.Refresh"
                          Click="Refresh_Click"
                          InputGestureText="F5"/>

                <MenuItem x:Name="CtxPrint"
                          Header="Print"
                          loc:LocProps.Key="Buttons.Print"
                          Click="Print_Click"/>

            </ContextMenu>

        </TreeView.ContextMenu>

    </TreeView>

</Grid>


</local:BaseWin>
