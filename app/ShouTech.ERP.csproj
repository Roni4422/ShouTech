<Project Sdk="Microsoft.NET.Sdk">

  <!-- ShouTech ERP desktop application; kept with the presentation layer. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ShouTech.App</RootNamespace>
    <AssemblyName>ShouTech.ERP</AssemblyName>
    <Version>10.6.0</Version>
    <AssemblyVersion>10.6.0.0</AssemblyVersion>
    <FileVersion>10.6.0.0</FileVersion>
    <InformationalVersion>10.6.0</InformationalVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Prefer32Bit>false</Prefer32Bit>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Npgsql" Version="9.0.2" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Dapper" Version="2.1.44" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Dom\Dom.csproj" />
    <ProjectReference Include="..\src\App\App.csproj" />
    <ProjectReference Include="..\src\Infra\Infra.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="..\App.xaml" Link="App.xaml" />
    <Page Include="**\*.xaml" Exclude="obj\**\*;bin\**\*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Page>
    <Compile Include="..\App.xaml.cs" />
    <Compile Include="**\*.cs" Exclude="obj\**\*;bin\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\cfg\appset.json" Link="cfg/appset.json" Condition="Exists('..\cfg\appset.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Resources\Errors\*.json" Link="Resources\Errors\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\Lang\*.json" Link="Resources\Lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\docs\USER_GUIDE_EN.md" Link="docs/USER_GUIDE_EN.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\COA\**\*" Link="Resources\COA\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\Currencies\**\*" Link="Resources\Currencies\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Resources\Ico\**\*.png"><Link>Resources\Ico\%(RecursiveDir)%(Filename)%(Extension)</Link></Resource>
    <Resource Include="Resources\Ico\**\*.jpg"><Link>Resources\Ico\%(RecursiveDir)%(Filename)%(Extension)</Link></Resource>
    <Resource Include="Resources\Ico\**\*.svg"><Link>Resources\Ico\%(RecursiveDir)%(Filename)%(Extension)</Link></Resource>
    <Resource Include="Resources\Ico\**\*.ico"><Link>Resources\Ico\%(RecursiveDir)%(Filename)%(Extension)</Link></Resource>
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kern.Tests" />
    <InternalsVisibleTo Include="NumHarness" />
    <InternalsVisibleTo Include="PerfHarness" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\dba\mig\sqlite\*.sql" Link="dba/mig/sqlite/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\dba\mig\sqlite')" />
    <None Include="..\dba\mig\postgresql\*.sql" Link="dba/mig/postgresql/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\dba\mig\postgresql')" />
  </ItemGroup>
</Project>
