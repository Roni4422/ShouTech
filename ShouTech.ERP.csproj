<Project Sdk="Microsoft.NET.Sdk">

  <!-- ================================================================
       ShouTech ERP
       Main WPF Application Project
       Target: .NET 8 / Windows / x64
       ================================================================ -->

  <PropertyGroup>

    <!-- Application -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>

    <!-- WPF -->
    <UseWPF>true</UseWPF>

    <!-- Language / Code Quality -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Assembly Identity -->
    <RootNamespace>ShouTech.App</RootNamespace>
    <AssemblyName>ShouTech.ERP</AssemblyName>

    <Version>10.6.0</Version>
    <AssemblyVersion>10.6.0.0</AssemblyVersion>
    <FileVersion>10.6.0.0</FileVersion>
    <InformationalVersion>10.6.0</InformationalVersion>

    <!-- Platform -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!-- WPF Application Entry Point / Manual File Control -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>

    <!-- Build Configuration -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Deterministic Builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>

    <!-- Runtime / Deployment -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <Prefer32Bit>false</Prefer32Bit>

    <!-- Modern SDK Behavior -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

  </PropertyGroup>


  <!-- ================================================================
       NuGet Packages 
       ================================================================ -->
  <ItemGroup>

    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Npgsql" Version="9.0.2" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Dapper" Version="2.1.44" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />

  </ItemGroup>


  <!-- ================================================================
       Internal Project References
       ================================================================ -->
  <ItemGroup>

    <ProjectReference Include="ShouTech.ERP.Com\cod\cor\inv.csproj" />
    <ProjectReference Include="ShouTech.ERP.Com\src\Domain\Domain.csproj" />
    <ProjectReference Include="ShouTech.ERP.Com\src\App\App.csproj" />
    <ProjectReference Include="ShouTech.ERP.Com\src\Infra\Infra.csproj" />

  </ItemGroup>


  <!-- ================================================================
       Application Definition
       ================================================================ -->
  <ItemGroup>

    <ApplicationDefinition Include="App.xaml" />

  </ItemGroup>


  <!-- ================================================================
       WPF XAML Pages
       ================================================================ -->
  <ItemGroup>

    <Page Include="ShouTech.ERP.Com\cod\app\src\**\*.xaml"
          Exclude="ShouTech.ERP.Com\cod\app\src\App.xaml;ShouTech.ERP.Com\cod\app\src\obj\**\*;ShouTech.ERP.Com\cod\app\src\bin\**\*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Page>

  </ItemGroup>


  <!-- ================================================================
       C# Source Files
       ================================================================ -->
  <ItemGroup>

    <!-- Application Source -->
    <Compile Include="App.xaml.cs" />
    <Compile Include="ShouTech.ERP.Com\cod\app\src\**\*.cs"
             Exclude="ShouTech.ERP.Com\cod\app\src\App.xaml.cs;ShouTech.ERP.Com\cod\app\src\obj\**\*;ShouTech.ERP.Com\cod\app\src\bin\**\*" />

  </ItemGroup>


  <!-- ================================================================
       Optional Configuration Files
       ================================================================ -->
  <ItemGroup>

    <None Include="ShouTech.ERP.Com\cfg\appset.json" Link="cfg/appset.json" Condition="Exists('ShouTech.ERP.Com\cfg\appset.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="ShouTech.ERP.Com\cod\app\src\Resources\Errors\*.json" Link="Resources\Errors\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="ShouTech.ERP.Com\cod\app\src\Resources\Lang\*.json" Link="Resources\Lang\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="ShouTech.ERP.Com\docs\USER_GUIDE_EN.md" Link="docs/USER_GUIDE_EN.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="ShouTech.ERP.Com\cod\app\src\Resources\COA\**\*" Link="Resources\COA\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="ShouTech.ERP.Com\cod\app\src\Resources\Currencies\**\*" Link="Resources\Currencies\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	

  </ItemGroup>
  
  <ItemGroup>
	<Resource Include="ShouTech.ERP.Com\cod\app\src\Resources\Ico\**\*.png"><Link>Resources\Ico\%(RecursiveDir)%(Filename)%(Extension)</Link></Resource>
    <Resource Include="ShouTech.ERP.Com\cod\app\src\Resources\Ico\**\*.jpg"><Link>Resources\Ico\%(RecursiveDir)%(Filename)%(Extension)</Link></Resource>
    <Resource Include="ShouTech.ERP.Com\cod\app\src\Resources\Ico\**\*.svg"><Link>Resources\Ico\%(RecursiveDir)%(Filename)%(Extension)</Link></Resource>
	<Resource Include="ShouTech.ERP.Com\cod\app\src\Resources\Ico\**\*.ico"><Link>Resources\Ico\%(RecursiveDir)%(Filename)%(Extension)</Link></Resource>
  </ItemGroup>


  <!-- ================================================================
       Build Output Organization
       ================================================================ -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- ================================================================
       Publish Defaults
       ================================================================ -->
  <PropertyGroup>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>


  <ItemGroup>
    <!-- Lets Kern.Tests exercise the internal STEI export/import engine
         (SteiSvc/SteiCrypto) end-to-end against real SQLite databases. -->
    <InternalsVisibleTo Include="Kern.Tests" />
    <InternalsVisibleTo Include="NumHarness" />
    <!-- Lets PerfHarness time the internal startup-path segments
         (SqliteSchemaBootstrapper.EnsureDatabase) headlessly. -->
    <InternalsVisibleTo Include="PerfHarness" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ShouTech.ERP.Com\dba\mig\sqlite\*.sql" Link="dba/mig/sqlite/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('ShouTech.ERP.Com\dba\mig\sqlite')" />
    <None Include="ShouTech.ERP.Com\dba\mig\postgresql\*.sql" Link="dba/mig/postgresql/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('ShouTech.ERP.Com\dba\mig\postgresql')" />
  </ItemGroup>
</Project>