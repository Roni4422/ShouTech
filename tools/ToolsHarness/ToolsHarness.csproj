<Project Sdk="Microsoft.NET.Sdk">

  <!-- ToolsHarness: headless proof for the unified Tools window
       (TOOLS_WINDOW_STUDY §8). Runs the REAL backup engine, AppConfig store and Operations stack against a real
       SchemaMigrator-built SQLite database and prints PASS/FAIL lines.
       On Linux the WindowsDesktop framework entry is stripped from the
       generated runtimeconfig before execution (the exercised code
       paths load no WPF types); on Windows it runs as-is. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ToolsHarness</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ShouTech.ERP.csproj" />
  </ItemGroup>

</Project>
