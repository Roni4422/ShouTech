<Project Sdk="Microsoft.NET.Sdk">

  <!-- InfoHarness: headless proof for the global Information Window
       (INFO_WINDOW_STUDY §7). Runs the REAL InfoSvc against a real
       SchemaMigrator-built SQLite database and prints PASS/FAIL lines.
       On Linux the WindowsDesktop framework entry is stripped from the
       generated runtimeconfig before execution (the exercised code
       paths load no WPF types); on Windows it runs as-is. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>InfoHarness</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ShouTech.ERP.csproj" />
  </ItemGroup>

</Project>
