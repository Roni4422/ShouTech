<Project Sdk="Microsoft.NET.Sdk">

  <!-- P2P consolidated purchase-cycle harness: runs the REAL services
       (PurchaseRequisitionWorkflowService, OrderService chain,
       ReconciliationRepository, InvRepo PRT, PurchaseLandedCostService,
       RptQuery GRNI tie-out) through the owner report's 10-stage spine
       against a real SchemaMigrator-built SQLite database and prints
       PASS/FAIL counts. On Linux the WindowsDesktop framework entry is
       stripped from the generated runtimeconfig before execution (the
       exercised code paths load no WPF types); on Windows it runs
       as-is. See docs/PURCHASE_CYCLE_COMPLETION.md §6. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>P2pHarness</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ShouTech.ERP.csproj" />
  </ItemGroup>

</Project>
