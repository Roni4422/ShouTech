<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\cod\app\src\MainApp.csproj" />
    <ProjectReference Include="..\..\tools\SqlMigrator\SqlMigrator.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopySqlMigratorForIntegrationTests" AfterTargets="Build">
    <ItemGroup>
      <SqlMigratorOutput Include="$(MSBuildProjectDirectory)\..\..\tools\SqlMigrator\bin\$(Configuration)\net8.0\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(SqlMigratorOutput)"
      DestinationFiles="@(SqlMigratorOutput->'$(OutDir)tools\SqlMigrator\bin\$(Configuration)\net8.0\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
