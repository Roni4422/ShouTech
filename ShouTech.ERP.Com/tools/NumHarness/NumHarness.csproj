<Project Sdk="Microsoft.NET.Sdk">

  <!-- NumHarness: headless proof for automatic sequential numbering
       (NUMBERING_STUDY). Runs the REAL allocator (SequenceAllocator),
       the REAL document path (InvRepo) and the REAL bin (DocBinSvc)
       against a SchemaMigrator-built SQLite database. On Linux the
       WindowsDesktop framework entry is stripped from the generated
       runtimeconfig before execution; on Windows it runs as-is. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NumHarness</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\ShouTech.ERP.csproj" />
  </ItemGroup>

</Project>
