<Project Sdk="Microsoft.NET.Sdk">

  <!-- FmtHarness: headless proof for the Options-governed display
       formats (OPTWIN_SECTIONS §3.2, Landing 1). Runs the REAL
       formatter core (ShouTech.Domain.NumFmt), the REAL print
       consumer (DocDesign.FormatLineValue) under two different
       installed settings, and the REAL UsrPref -> NumFmtSettings
       mapping. On Linux the WindowsDesktop framework entry is
       stripped from the generated runtimeconfig before execution;
       on Windows it runs as-is. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FmtHarness</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\cod\app\src\MainApp.csproj" />
  </ItemGroup>

</Project>
