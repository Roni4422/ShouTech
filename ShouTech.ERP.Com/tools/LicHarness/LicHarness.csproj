<Project Sdk="Microsoft.NET.Sdk">

  <!-- LicHarness: headless proof for the licensing & protection build
       (docs/LICENSING_BUILD.md). Drives the REAL entitlement chain,
       fingerprint matcher, verdict store, check-in client and backup
       upload against an in-process mock server (test vendor keypair),
       and prints PASS/FAIL lines. On Linux the WindowsDesktop
       framework entry is stripped from the generated runtimeconfig
       before execution (the exercised code paths load no WPF types);
       on Windows it runs as-is. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LicHarness</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\cod\app\src\MainApp.csproj" />
  </ItemGroup>

</Project>
