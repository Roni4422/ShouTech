<local:BaseWin x:Class="ShouTech.App.Views.DatWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShouTech.App.Views"
        Title="Data Import &amp; Export"
        Width="860"
        Height="700"
        MinWidth="660"
        MinHeight="360"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource ShellChromeFontFamily}"
        FontSize="{DynamicResource FontSize13}"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="14">
        <!-- Row sizing is load-bearing: the DETAIL panel (row 2) takes the
             flexible space so a long content list (dataset export) scrolls
             INSIDE its panel. When this row was Auto, the dataset ListBox
             sized to every item, pushed the format strip, activity panel
             and the bottom command bar off the window, and the export
             button became unreachable. The activity panel (row 4) is
             fixed-height instead (see ResultTextBox Height). -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header zone: title + live shell context (company / database / provider / user). -->
        <Border Grid.Row="0" Padding="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{DynamicResource VisuTitleStyle}" Text="Data Import &amp; Export"/>
                    <TextBlock x:Name="PathHintText" Style="{DynamicResource VisuTextSecondaryStyle}" TextWrapping="Wrap" Margin="0,3,12,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="18,0,0,0">
                        <TextBlock x:Name="ContextUserLabel" Style="{DynamicResource VisuCaptionStyle}" Text="User"/>
                        <TextBlock x:Name="ContextUserValue" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Margin="18,0,0,0">
                        <TextBlock x:Name="ContextCompanyLabel" Style="{DynamicResource VisuCaptionStyle}" Text="Company"/>
                        <TextBlock x:Name="ContextCompanyValue" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Margin="18,0,0,0">
                        <TextBlock x:Name="ContextDatabaseLabel" Style="{DynamicResource VisuCaptionStyle}" Text="Database"/>
                        <TextBlock x:Name="ContextDatabaseValue" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Margin="18,0,0,0">
                        <TextBlock x:Name="ContextProviderLabel" Style="{DynamicResource VisuCaptionStyle}" Text="Provider"/>
                        <TextBlock x:Name="ContextProviderValue" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Operation cards: one card per operation family; the active card takes the accent style. -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ImportCardButton" Grid.Column="0" Tag="Import" Style="{DynamicResource VisuSecondaryButtonStyle}" Height="78" Margin="0,0,6,0" Click="ModeCard_Click">
                <StackPanel Margin="6,4">
                    <TextBlock x:Name="ImportCardTitle" FontWeight="SemiBold" FontSize="{DynamicResource FontSize14}" TextAlignment="Center" TextWrapping="Wrap" Text="Import Data"/>
                    <TextBlock x:Name="ImportCardDesc" FontSize="{DynamicResource FontSize12}" Opacity="0.85" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="ExportCardButton" Grid.Column="1" Tag="Export" Style="{DynamicResource VisuSecondaryButtonStyle}" Height="78" Margin="6,0,6,0" Click="ModeCard_Click">
                <StackPanel Margin="6,4">
                    <TextBlock x:Name="ExportCardTitle" FontWeight="SemiBold" FontSize="{DynamicResource FontSize14}" TextAlignment="Center" TextWrapping="Wrap" Text="Export Data"/>
                    <TextBlock x:Name="ExportCardDesc" FontSize="{DynamicResource FontSize12}" Opacity="0.85" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="DatasetCardButton" Grid.Column="2" Tag="StructuredExport" Style="{DynamicResource VisuSecondaryButtonStyle}" Height="78" Margin="6,0,0,0" Click="ModeCard_Click">
                <StackPanel Margin="6,4">
                    <TextBlock x:Name="DatasetCardTitle" FontWeight="SemiBold" FontSize="{DynamicResource FontSize14}" TextAlignment="Center" TextWrapping="Wrap" Text="Excel / PDF"/>
                    <TextBlock x:Name="DatasetCardDesc" FontSize="{DynamicResource FontSize12}" Opacity="0.85" TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Detail panel: the selected operation's fields, grouped on one section card. -->
        <Border Grid.Row="2" Style="{DynamicResource VisuSectionCardStyle}" Margin="0,12,0,0">
            <Grid>
                <Grid x:Name="ImportPanel">
                    <StackPanel>
                        <Grid x:Name="ImportDropZone" MinHeight="64" Margin="0,0,0,10" AllowDrop="True" DragOver="ImportDropZone_DragOver" Drop="ImportDropZone_Drop">
                            <Rectangle Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1" StrokeDashArray="4,3" Fill="{DynamicResource SurfaceSecondaryBrush}" RadiusX="8" RadiusY="8"/>
                            <StackPanel VerticalAlignment="Center" Margin="12,8">
                                <TextBlock x:Name="DropZoneTitleText" FontWeight="SemiBold" TextAlignment="Center" Text="Drag &amp; drop the import file here"/>
                                <TextBlock x:Name="DropZoneHintText" Style="{DynamicResource VisuCaptionStyle}" TextAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ImportPathBox" Grid.Column="0" Style="{DynamicResource VisuTextBoxStyle}" Height="30" Padding="8,5" IsReadOnly="True" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="ImportBrowseButton" Style="{DynamicResource VisuSecondaryButtonStyle}" Content="..." Width="34" Height="30" Margin="7,0,0,0" Padding="4,0" ToolTip="Choose file" Click="ImportBrowse_Click"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ImportDatasetLabel" Grid.Column="0" Text="Dataset type" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ImportDatasetBox" Grid.Column="1" Style="{DynamicResource VisuComboBoxStyle}" Height="30" DisplayMemberPath="DisplayName" SelectionChanged="ImportDatasetBox_SelectionChanged"/>
                        </Grid>
                        <TextBlock x:Name="ImportHintText" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.78" Text="Editable Excel data can be imported only with its original encrypted type marker and unchanged column headers."/>
                        <StackPanel x:Name="ImportModePanel" Margin="0,8,0,0">
                            <TextBlock x:Name="ImportModeLabel" FontWeight="SemiBold" Text="Import mode for master data (e.g. material cards)"/>
                            <RadioButton x:Name="ImportUpsertRadio" GroupName="ImportMode" IsChecked="True" Margin="0,6,0,0"
                                         Content="Update / insert only — rows deleted from Excel stay in the database"/>
                            <RadioButton x:Name="ImportReplaceRadio" GroupName="ImportMode" Margin="0,4,0,0"
                                         Content="Wipe missing rows to recycle bin (soft-delete) — can restore from Bin on main window"/>
                            <TextBlock x:Name="ImportReplaceHintText" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.72"
                                       Text="Example: export materials, delete some cards in Excel, then import. Upsert keeps them in DB; wipe-to-bin moves missing cards to the recycle bin so you can restore them later."/>
                        </StackPanel>
                        <Grid x:Name="ImportPasswordGrid" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ImportPasswordLabel" Grid.Column="0" Text="Package password" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <PasswordBox x:Name="ImportPasswordBox" Grid.Column="1" Style="{DynamicResource VisuPasswordBoxStyle}" Height="28" Padding="7,4"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ExportPanel" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExportPathBox" Grid.Column="0" Style="{DynamicResource VisuTextBoxStyle}" Height="30" Padding="8,5" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="ExportBrowseButton" Style="{DynamicResource VisuSecondaryButtonStyle}" Content="..." Width="34" Height="30" Margin="7,0,0,0" Padding="4,0" ToolTip="Choose destination" Click="ExportBrowse_Click"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ExportPasswordLabel" Grid.Row="0" Grid.Column="0" Text="Package password" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <PasswordBox x:Name="ExportPasswordBox" Grid.Row="0" Grid.Column="1" Style="{DynamicResource VisuPasswordBoxStyle}" Height="28" Padding="7,4" Margin="0,0,0,6"/>
                            <TextBlock x:Name="ExportPasswordConfirmLabel" Grid.Row="1" Grid.Column="0" Text="Confirm password" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <PasswordBox x:Name="ExportPasswordConfirmBox" Grid.Row="1" Grid.Column="1" Style="{DynamicResource VisuPasswordBoxStyle}" Height="28" Padding="7,4"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid x:Name="DatasetPanel" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="StructuredExportHintText"
                                   Text="Choose a dataset and export it as Excel or PDF."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="ExportSearchBox"
                                 Grid.Row="1"
                                 Margin="0,0,0,8"
                                 Height="30"
                                 Padding="8,5"
                                 Style="{DynamicResource VisuTextBoxStyle}"
                                 TextChanged="ExportSearchBox_TextChanged"/>
                        <ListBox x:Name="ExportItemsList"
                                 Grid.Row="2"
                                 Style="{DynamicResource VisuListBoxStyle}"
                                 DisplayMemberPath="DisplayName"
                                 SelectionMode="Single"
                                 MinHeight="150"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <Grid x:Name="DatasetPasswordGrid" Grid.Row="3" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="DatasetPasswordLabel" Grid.Row="0" Grid.Column="0" Text="Package password" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <PasswordBox x:Name="DatasetPasswordBox" Grid.Row="0" Grid.Column="1" Style="{DynamicResource VisuPasswordBoxStyle}" Height="28" Padding="7,4" Margin="0,0,0,6"/>
                            <TextBlock x:Name="DatasetPasswordConfirmLabel" Grid.Row="1" Grid.Column="0" Text="Confirm password" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <PasswordBox x:Name="DatasetPasswordConfirmBox" Grid.Row="1" Grid.Column="1" Style="{DynamicResource VisuPasswordBoxStyle}" Height="28" Padding="7,4"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Format strip: shared by the two export modes (hidden while importing). -->
        <Grid x:Name="FormatStrip" Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ExportFormatLabel" Grid.Column="0" Text="Format" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="ExportFormatBox"
                      Grid.Column="1"
                      Style="{DynamicResource VisuComboBoxStyle}"
                      Height="32"
                      SelectedIndex="0"
                      SelectionChanged="ExportFormatBox_SelectionChanged">
                <ComboBoxItem Content="Excel (.xlsx)" Tag="xlsx"/>
                <ComboBoxItem Content="PDF (.pdf)" Tag="pdf"/>
                <ComboBoxItem Content="Encrypted dataset package (.stei)" Tag="stei"/>
            </ComboBox>
        </Grid>

        <!-- Activity panel: status, progress and the full result of the last operation. -->
        <Border Grid.Row="4" Style="{DynamicResource VisuCardStyle}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ResultTitleText" FontWeight="SemiBold" Text="Operation result"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                    <TextBlock x:Name="ResultStatusText" FontWeight="SemiBold" Text="Ready"/>
                    <ProgressBar x:Name="OperationProgress" Width="150" Height="8" Margin="14,0,0,0" VerticalAlignment="Center" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                </StackPanel>
                <TextBox x:Name="ResultTextBox" Grid.Row="2" Height="84" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent" Padding="0"/>
            </Grid>
        </Border>

        <!-- Bottom command bar: all actions live here (standing layout rule). -->
        <Border Grid.Row="5" Margin="0,10,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" local:FlowAlign.AlignEnd="True">
                <Button x:Name="StartButton" Style="{DynamicResource VisuAccentButtonStyle}" Content="Start" Padding="18,6" MinWidth="140" Click="StartButton_Click"/>
                <Button x:Name="DetailsButton" Style="{DynamicResource VisuSecondaryButtonStyle}" Content="View details" Margin="8,0,0,0" Padding="10,5" IsEnabled="False" Click="DetailsButton_Click"/>
                <Button x:Name="CloseButton" Style="{DynamicResource VisuSecondaryButtonStyle}" Content="Close" Margin="8,0,0,0" Padding="14,5" Click="CloseButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</local:BaseWin>
