<local:BaseWin x:Class="ShouTech.App.Views.CatWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShouTech.App.Views"
        xmlns:loc="clr-namespace:ShouTech.App.Localization"
        Title="Category Card"
        loc:LocProps.WindowKey="CatWin.Title"
        Width="880"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource ApplicationFontFamily}"
        FontSize="{DynamicResource FontSize12}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

        <Window.Resources>

			<!-- =========================================================
				 FIELD STYLES
				 Alignment follows Window.FlowDirection through a
				 DataTrigger. No hardcoded alignment anywhere.
				 ========================================================= -->

			<Style x:Key="FieldLabel" TargetType="TextBlock">
				<Setter Property="FontSize" Value="{DynamicResource FontSize11}"/>
				<Setter Property="FontWeight" Value="SemiBold"/>
				<Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
				<Setter Property="Margin" Value="0,0,0,3"/>
				<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
				<Setter Property="TextAlignment" Value="Left"/>
				<Style.Triggers>
					<DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								 Value="RightToLeft">
						<Setter Property="TextAlignment" Value="Right"/>
					</DataTrigger>
					<DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								 Value="LeftToRight">
						<Setter Property="TextAlignment" Value="Left"/>
					</DataTrigger>
				</Style.Triggers>
			</Style>

			<Style x:Key="FieldBox" TargetType="TextBox"
				   BasedOn="{StaticResource AppTextBoxStyle}">
				<Setter Property="Height" Value="28"/>
				<Setter Property="Padding" Value="8,0"/>
				<Setter Property="FontSize" Value="{DynamicResource FontSize11}"/>
				<Setter Property="VerticalContentAlignment" Value="Center"/>
				<Setter Property="Margin" Value="0,0,0,10"/>
				<Setter Property="TextAlignment" Value="Left"/>
				<Style.Triggers>
					<DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								 Value="RightToLeft">
						<Setter Property="TextAlignment" Value="Right"/>
					</DataTrigger>
					<DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								 Value="LeftToRight">
						<Setter Property="TextAlignment" Value="Left"/>
					</DataTrigger>
				</Style.Triggers>
			</Style>

			<!--
				Left-to-right content (codes, Latin names).
				FlowDirection is fixed LTR so the characters render in reading
				order, but TextAlignment still follows the window language:
				right in Arabic, left in English.
			-->
			<Style x:Key="FieldBoxLtr" TargetType="TextBox"
				   BasedOn="{StaticResource FieldBox}">
				<Setter Property="FlowDirection" Value="LeftToRight"/>
			</Style>

			<Style x:Key="FieldCombo" TargetType="ComboBox"
				   BasedOn="{StaticResource AppComboBoxStyle}">
				<Setter Property="Height" Value="28"/>
				<Setter Property="FontSize" Value="{DynamicResource FontSize11}"/>
				<Setter Property="VerticalContentAlignment" Value="Center"/>
				<Setter Property="Margin" Value="0,0,0,10"/>
				<Setter Property="HorizontalContentAlignment" Value="Left"/>
				<Style.Triggers>
					<DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								 Value="RightToLeft">
						<Setter Property="HorizontalContentAlignment" Value="Right"/>
					</DataTrigger>
					<DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								 Value="LeftToRight">
						<Setter Property="HorizontalContentAlignment" Value="Left"/>
					</DataTrigger>
				</Style.Triggers>
			</Style>

			<!-- Search box: alignment follows language, padding follows icon side -->
			<Style x:Key="SearchBox" TargetType="TextBox"
				   BasedOn="{StaticResource AppTextBoxStyle}">
				<Setter Property="Height" Value="28"/>
				<Setter Property="FontSize" Value="{DynamicResource FontSize11}"/>
				<Setter Property="VerticalContentAlignment" Value="Center"/>
				<Setter Property="Padding" Value="30,2,8,2"/>
				<Setter Property="TextAlignment" Value="Left"/>
				<Style.Triggers>
					<DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								 Value="RightToLeft">
						<Setter Property="Padding" Value="8,2,30,2"/>
						<Setter Property="TextAlignment" Value="Right"/>
					</DataTrigger>
					<DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
								 Value="LeftToRight">
						<Setter Property="Padding" Value="30,2,8,2"/>
						<Setter Property="TextAlignment" Value="Left"/>
					</DataTrigger>
				</Style.Triggers>
			</Style>

			<!-- Toolbar button -->
			<Style x:Key="ToolbarButton" TargetType="Button"
				   BasedOn="{StaticResource SecondaryButtonStyle}">
				<Setter Property="Height" Value="28"/>
				<Setter Property="MinWidth" Value="86"/>
				<Setter Property="Padding" Value="12,0"/>
				<Setter Property="Margin" Value="0"/>
				<Setter Property="FontSize" Value="{DynamicResource FontSize11}"/>
			</Style>

			<!-- Footer buttons -->
			<Style x:Key="FooterButton" TargetType="Button"
				   BasedOn="{StaticResource SecondaryButtonStyle}">
				<Setter Property="Height" Value="28"/>
				<Setter Property="MinWidth" Value="82"/>
				<Setter Property="Padding" Value="12,0"/>
				<Setter Property="Margin" Value="4,0,0,0"/>
				<Setter Property="FontSize" Value="{DynamicResource FontSize11}"/>
			</Style>

			<Style x:Key="FooterPrimaryButton" TargetType="Button"
				   BasedOn="{StaticResource PrimaryButtonStyle}">
				<Setter Property="Height" Value="28"/>
				<Setter Property="MinWidth" Value="82"/>
				<Setter Property="Padding" Value="12,0"/>
				<Setter Property="Margin" Value="4,0,0,0"/>
				<Setter Property="FontSize" Value="{DynamicResource FontSize11}"/>
			</Style>

			<!-- Card container -->
			<Style x:Key="CardBorder" TargetType="Border">
				<Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Setter Property="CornerRadius" Value="4"/>
				<Setter Property="Padding" Value="14,12"/>
			</Style>

		</Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =========================================================
             TOOLBAR
             ========================================================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Card number badge -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Card No."
                               loc:LocProps.Key="CatWin.AutoNo"
                               Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="10,3">
                        <TextBlock x:Name="TxtCardNo"
                                   FontWeight="SemiBold"
                                   FontSize="{DynamicResource FontSize11}"
                                   Foreground="{DynamicResource AccentDark}"
                                   FlowDirection="LeftToRight"
                                   MinWidth="50"
                                   TextAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Search box -->
                <Grid Grid.Column="1"
                      MaxWidth="340"
                      Margin="20,0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <TextBox x:Name="TxtSearch"
                             Style="{StaticResource SearchBox}"
                             loc:LocProps.ToolTipKey="CatWin.SearchTooltip"
                             ToolTip="Search by code or name - press Enter"
                             KeyDown="TxtSearch_KeyDown"/>
                    <TextBlock x:Name="IcoSearch"
							   Text="&#x1F50D;"
							   FontSize="{DynamicResource FontSize13}"
							   VerticalAlignment="Center"
							   Margin="8,0,0,0"
							   IsHitTestVisible="False"
							   Opacity="0.55">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="HorizontalAlignment" Value="Left"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
												 Value="RightToLeft">
										<Setter Property="HorizontalAlignment" Value="Right"/>
									</DataTrigger>
									<DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
												 Value="LeftToRight">
										<Setter Property="HorizontalAlignment" Value="Left"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
                </Grid>

                <!-- Refresh -->
                <Button x:Name="BtnRefresh"
                        Grid.Column="2"
                        Content="Refresh"
                        loc:LocProps.Key="CatWin.Refresh"
                        Style="{StaticResource ToolbarButton}"
                        Click="Refresh_Click"/>
            </Grid>
        </Border>

        <!-- =========================================================
             MAIN CONTENT
             ========================================================= -->
        <Grid Grid.Row="1" Margin="12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="320"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: form -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- Item Code -->
                        <TextBlock Text="Item Code"
                                   loc:LocProps.Key="CatWin.ItemCode"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtCode"
                                 Style="{StaticResource FieldBoxLtr}"
                                 TextAlignment="Left"
                                 MaxLength="40"/>

                        <!-- Item Name -->
                        <TextBlock Text="Item Name"
                                   loc:LocProps.Key="CatWin.ItemName"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtName"
                                 Style="{StaticResource FieldBox}"
                                 MaxLength="120"/>

                        <!-- Latin Name -->
                        <TextBlock Text="Latin Name"
                                   loc:LocProps.Key="CatWin.NameLatin"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtNameEn"
                                 Style="{StaticResource FieldBoxLtr}"
                                 TextAlignment="Left"
                                 MaxLength="120"/>

                        <!-- Warehouse -->
                        <TextBlock Text="Warehouse"
                                   loc:LocProps.Key="CatWin.Warehouse"
                                   Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbWarehouse"
                                  Style="{StaticResource FieldCombo}"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="Code"
                                  IsEditable="False"/>

                        <!-- Specifications -->
                        <TextBlock Text="General Specifications"
                                   loc:LocProps.Key="CatWin.GeneralSpecs"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtSpecs"
                                 Style="{StaticResource FieldBox}"
                                 Height="70"
                                 Padding="8,6"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxLength="2000"
                                 Margin="0,0,0,10"/>

                        <!-- Image -->
                        <TextBlock Text="Item Image"
                                   loc:LocProps.Key="CatWin.Image"
                                   Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="80"
                                    Height="80"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Background="{DynamicResource FieldBackgroundBrush}"
                                    CornerRadius="3"
                                    Margin="0,0,10,0">
                                <Image x:Name="ImgPreview"
                                       Stretch="Uniform"
                                       Margin="3"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button x:Name="BtnPickImage"
                                        Content="Choose Image..."
                                        loc:LocProps.Key="CatWin.PickImage"
                                        Style="{StaticResource ToolbarButton}"
                                        Margin="0,0,0,6"
                                        HorizontalAlignment="Stretch"
                                        Click="PickImage_Click"/>
                                <Button x:Name="BtnClearImage"
                                        Content="Remove Image"
                                        loc:LocProps.Key="CatWin.ClearImage"
                                        Style="{StaticResource ToolbarButton}"
                                        Margin="0"
                                        HorizontalAlignment="Stretch"
                                        Click="ClearImage_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Mode indicator -->
                        <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8,4"
                                Margin="0,8,0,0">
                            <TextBlock x:Name="TxtMode"
                                       FontSize="{DynamicResource FontSize10_5}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentDark}"
                                       Text="Ready"/>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT COLUMN: tree -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>

                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4C1;"
                                       FontSize="{DynamicResource FontSize12}"
                                       Foreground="{DynamicResource AccentDark}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       FlowDirection="LeftToRight"/>
                            <TextBlock Text="Category Tree"
									   loc:LocProps.Key="CatWin.TreeTitle"
									   FontWeight="SemiBold"
									   FontSize="{DynamicResource FontSize11}"
									   Foreground="{DynamicResource AccentDark}"
									   VerticalAlignment="Center"
									   TextAlignment="Left">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Style.Triggers>
											<DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
														 Value="RightToLeft">
												<Setter Property="TextAlignment" Value="Right"/>
											</DataTrigger>
											<DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
														 Value="LeftToRight">
												<Setter Property="TextAlignment" Value="Left"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
                        </StackPanel>
                    </Border>

                    <TreeView x:Name="TreeGroups"
                              BorderThickness="0"
                              Padding="6,4"
                              Background="Transparent"
                              FontSize="{DynamicResource FontSize11}"
                              SelectedItemChanged="TreeGroups_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Padding" Value="2,3"/>
                                <Setter Property="FontSize" Value="{DynamicResource FontSize11}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>

                </DockPanel>
            </Border>
        </Grid>

        <!-- =========================================================
             FOOTER
             ========================================================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceSecondaryBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSize11}"
                           Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="BtnNew"
                            Content="New"
                            loc:LocProps.Key="Buttons.New"
                            Style="{StaticResource FooterButton}"
                            Click="New_Click"/>
                    <Button x:Name="BtnEdit"
                            Content="Edit"
                            loc:LocProps.Key="Buttons.Edit"
                            Style="{StaticResource FooterButton}"
                            Click="Edit_Click"/>
                    <Button x:Name="BtnDelete"
                            Content="Delete"
                            loc:LocProps.Key="Buttons.Delete"
                            Style="{StaticResource FooterButton}"
                            Click="Delete_Click"/>
                    <Button x:Name="BtnSave"
                            Content="Save"
                            loc:LocProps.Key="Buttons.Save"
                            Style="{StaticResource FooterPrimaryButton}"
                            Click="Save_Click"/>
                    <Button x:Name="BtnClose"
                            Content="Close"
                            loc:LocProps.Key="Buttons.Close"
                            Style="{StaticResource FooterButton}"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</local:BaseWin>