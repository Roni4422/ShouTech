<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:wpf="clr-namespace:System.Windows;assembly=PresentationFramework"
    xmlns:interaction="clr-namespace:ShouTech.App.Interaction">

    <!-- =========================================================
         SHOUTECH ERP - CENTRAL VISUAL IDENTITY
         Single source of truth for application appearance.
         ========================================================= -->

    <!-- Identity metadata -->
    <System:String x:Key="ThemeName">Light</System:String>
    <System:String x:Key="VisualIdentityVersion">2026.4</System:String>

    <!-- Window material requested from Win11Chrome (DWM backdrop):
         None | Mica | MicaAlt. Read centrally by
         Services/Win11Chrome.cs; unsupported systems degrade to None. -->
    <System:String x:Key="WindowBackdropKind">Mica</System:String>


    <!-- =========================================================
         DESIGN TOKEN SYSTEM (2026-2035)
         Layered tokens. Component styles must reference SEMANTIC
         tokens only; semantic tokens resolve to PRIMITIVE values.
         A future dark palette only re-values the primitives and
         the semantic layer below - component styles never change.

           Layer 1  PRIMITIVES   raw palette / scale values
           Layer 2  SEMANTIC     purpose-named brushes and metrics
           Layer 3  COMPONENT    the styles further down this file
         ========================================================= -->

    <!-- ===== Layer 1: primitive neutral ramp =====
         Blue-gray (slate) family: the neutrals carry a muted
         blue cast so window surfaces read slate, not plain gray
         (owner directive 2026-11-24). Luminance order unchanged. -->
    <Color x:Key="NeutralWhiteColor">#FFFFFF</Color>
    <Color x:Key="Neutral50Color">#F8FAFB</Color>
    <Color x:Key="Neutral100Color">#F2F5F7</Color>
    <Color x:Key="Neutral150Color">#EAF0F3</Color>
    <Color x:Key="Neutral200Color">#E6EDF1</Color>
    <Color x:Key="Neutral250Color">#D8E1E8</Color>
    <Color x:Key="Neutral300Color">#C9D4DE</Color>
    <Color x:Key="Neutral400Color">#A9BACA</Color>
    <Color x:Key="Neutral500Color">#8E9EAC</Color>
    <Color x:Key="Neutral600Color">#5A6874</Color>
    <Color x:Key="Neutral900Color">#1F272E</Color>
    <Color x:Key="TextTertiaryColor">#6B7987</Color>

    <!-- ===== Layer 1: primitive accent (default palette = the
         slate "Blue Gray" family; the accent service in
         Services/VisuId.cs replaces the accent BRUSHES at
         application level when the user switches accent, so
         components keep referencing the brushes). ===== -->
    <Color x:Key="AccentPrimaryColor">#51708E</Color>
    <Color x:Key="AccentDarkColor">#3D576E</Color>
    <Color x:Key="AccentLightColor">#E8EEF3</Color>
    <Color x:Key="AccentHoverColor">#D3DEE8</Color>

    <!-- ===== Layer 1: primitive status colors + light tints ===== -->
    <Color x:Key="SuccessColor">#198754</Color>
    <Color x:Key="WarningColor">#D99100</Color>
    <Color x:Key="ErrorColor">#C0392B</Color>
    <Color x:Key="InfoColor">#2878B5</Color>
    <Color x:Key="SuccessDarkColor">#146C43</Color>
    <Color x:Key="ErrorDarkColor">#922B21</Color>
    <Color x:Key="SuccessTintColor">#E6F4EA</Color>
    <Color x:Key="WarningTintColor">#FEF7E0</Color>
    <Color x:Key="ErrorTintColor">#FDECEA</Color>
    <Color x:Key="InfoTintColor">#E8F0FE</Color>

    <!-- ===== Layer 2: semantic surface tokens ===== -->
    <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="{StaticResource Neutral100Color}"/>
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource NeutralWhiteColor}"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource NeutralWhiteColor}"/>
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{StaticResource Neutral200Color}"/>
    <SolidColorBrush x:Key="SurfaceFlyoutBrush" Color="{StaticResource NeutralWhiteColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource Neutral150Color}"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource Neutral200Color}"/>
    <!-- Accent-tinted selection wash. Services/VisuId.cs refreshes
         this brush (and AccentSubtleBrush / FocusRingBrush /
         FieldBorderFocusBrush) whenever the accent changes. -->
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#2651708E"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#2651708E"/>

    <!-- ===== Layer 2: semantic text tokens ===== -->
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource NeutralWhiteColor}"/>
    <SolidColorBrush x:Key="TextInverseBrush" Color="{StaticResource NeutralWhiteColor}"/>

    <!-- ===== Layer 2: semantic border / focus tokens ===== -->
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource Neutral250Color}"/>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource Neutral300Color}"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource AccentPrimaryColor}"/>

    <!-- ===== Layer 2: semantic field tokens ===== -->
    <SolidColorBrush x:Key="FieldBorderBrush" Color="{StaticResource Neutral300Color}"/>
    <SolidColorBrush x:Key="FieldBorderHoverBrush" Color="{StaticResource Neutral400Color}"/>
    <SolidColorBrush x:Key="FieldBorderFocusBrush" Color="{StaticResource AccentPrimaryColor}"/>
    <SolidColorBrush x:Key="FieldBackgroundHoverBrush" Color="{StaticResource Neutral50Color}"/>

    <!-- ===== Layer 2: semantic status surface tokens ===== -->
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{StaticResource SuccessTintColor}"/>
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource WarningTintColor}"/>
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="{StaticResource ErrorTintColor}"/>
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="{StaticResource InfoTintColor}"/>

    <!-- ===== Layer 2: compatibility tokens for module views
         (DashVw / ModuleWorkspaceView / ReportGridVw / MatCard /
         Lang / SerWin referenced these names before they existed;
         they now resolve to the semantic layer). ===== -->
    <SolidColorBrush x:Key="FieldBackground" Color="{StaticResource NeutralWhiteColor}"/>
    <SolidColorBrush x:Key="SideBackground" Color="{StaticResource Neutral200Color}"/>
    <SolidColorBrush x:Key="PanelBackground" Color="{StaticResource NeutralWhiteColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Neutral200Color}"/>
    <SolidColorBrush x:Key="ModuleCardBackgroundBrush" Color="{StaticResource NeutralWhiteColor}"/>
    <SolidColorBrush x:Key="ModuleCardBorderBrush" Color="{StaticResource Neutral300Color}"/>
    <SolidColorBrush x:Key="ModuleHeaderBackgroundBrush" Color="{StaticResource Neutral200Color}"/>

    <!-- ===== Spacing scale (4px grid) ===== -->
    <System:Double x:Key="Spacing0">0</System:Double>
    <System:Double x:Key="Spacing1">4</System:Double>
    <System:Double x:Key="Spacing2">8</System:Double>
    <System:Double x:Key="Spacing3">12</System:Double>
    <System:Double x:Key="Spacing4">16</System:Double>
    <System:Double x:Key="Spacing5">20</System:Double>
    <System:Double x:Key="Spacing6">24</System:Double>
    <System:Double x:Key="Spacing8">32</System:Double>
    <System:Double x:Key="Spacing10">40</System:Double>

    <Thickness x:Key="PaddingField">10,0</Thickness>
    <Thickness x:Key="PaddingCard">16</Thickness>
    <Thickness x:Key="PaddingDialog">24</Thickness>
    <Thickness x:Key="PaddingListItem">12,6</Thickness>
    <Thickness x:Key="PaddingMenuItem">10,6</Thickness>

    <!-- ===== Radius scale (controls stay crisp at 4px;
         containers scale 8-12px) ===== -->
    <CornerRadius x:Key="RadiusNone">0</CornerRadius>
    <CornerRadius x:Key="RadiusXSmall">2</CornerRadius>
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">8</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">12</CornerRadius>
    <CornerRadius x:Key="FlyoutCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CardLargeCornerRadius">12</CornerRadius>

    <!-- ===== Type ramp: Display face for headings, Text face
         for body (existing ApplicationFontFamily stays the
         canonical body token). ===== -->
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- ===== Elevation tokens (soft, restrained; flyouts and
         dialogs layer above cards) ===== -->
    <DropShadowEffect x:Key="CardShadowEffect"
                      Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.10"/>
    <DropShadowEffect x:Key="FlyoutShadowEffect"
                      Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.18"/>
    <DropShadowEffect x:Key="DialogShadowEffect"
                      Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.22"/>

    <!-- ===== Motion tokens (referenced by template storyboards;
         keep interactions at or below 300ms) ===== -->
    <Duration x:Key="MotionDurationFast">0:0:0.1</Duration>
    <Duration x:Key="MotionDurationNormal">0:0:0.167</Duration>
    <Duration x:Key="MotionDurationSlow">0:0:0.3</Duration>
    <CubicEase x:Key="MotionEaseOut" EasingMode="EaseOut"/>
    <CubicEase x:Key="MotionEaseIn" EasingMode="EaseIn"/>
    <CubicEase x:Key="MotionEaseStandard" EasingMode="EaseInOut"/>

    <!-- ===== Touch-friendly metric (dense ERP default stays
         ControlHeight = 32; touch surfaces opt into 40) ===== -->
    <System:Double x:Key="TouchControlHeight">40</System:Double>


    <!-- =========================================================
         TYPOGRAPHY
         ========================================================= -->

    <FontFamily x:Key="ApplicationFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="ApplicationFontFamilyStrong">Segoe UI Semibold</FontFamily>
    <System:Double x:Key="ApplicationFontSize">13</System:Double>
    <System:Double x:Key="FontSize9">9</System:Double>
    <System:Double x:Key="FontSize10">10</System:Double>
    <System:Double x:Key="FontSize10_5">10.5</System:Double>
    <System:Double x:Key="FontSize11">11</System:Double>
    <System:Double x:Key="FontSize12">12</System:Double>
    <System:Double x:Key="FontSize12_5">12.5</System:Double>
    <System:Double x:Key="FontSize13">13</System:Double>
    <System:Double x:Key="FontSize14">14</System:Double>
    <System:Double x:Key="FontSize15">15</System:Double>
    <System:Double x:Key="FontSize16">16</System:Double>
    <System:Double x:Key="FontSize17">17</System:Double>
    <System:Double x:Key="FontSize18">18</System:Double>
    <System:Double x:Key="FontSize19">19</System:Double>
    <System:Double x:Key="FontSize20">20</System:Double>
    <System:Double x:Key="FontSize21">21</System:Double>
    <System:Double x:Key="FontSize22">22</System:Double>
    <System:Double x:Key="FontSize23">23</System:Double>
    <System:Double x:Key="FontSize24">24</System:Double>
    <System:Double x:Key="FontSize26">26</System:Double>
    <System:Double x:Key="FontSize28">28</System:Double>
    <System:Double x:Key="FontSize30">30</System:Double>
    <System:Double x:Key="FontSize34">34</System:Double>
    <System:Double x:Key="FontSize48">48</System:Double>
    <System:Double x:Key="FontSize56">56</System:Double>


    <!-- =========================================================
         DIMENSIONS
         Keep numeric values typed according to the target property.
         ========================================================= -->

    <!-- Double values -->
    <System:Double x:Key="ControlHeight">32</System:Double>
    <System:Double x:Key="SmallControlHeight">24</System:Double>
    <System:Double x:Key="LargeControlHeight">32</System:Double>

    <System:Double x:Key="StandardSpacing">8</System:Double>
    <System:Double x:Key="LargeSpacing">16</System:Double>
    <System:Double x:Key="SectionSpacing">24</System:Double>

    <!-- CornerRadius values -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="Win11WindowCornerRadius">8</CornerRadius>

    <!-- Shared control metrics. Keep control sizing here, not duplicated in App.xaml.
         PROPORTION STANDARD (docs/WINDOW_PROPORTIONS.md): ONE height for every
         input and button = ControlHeight (32, Fluent standard). The button and
         text-input height tokens below are pinned to that same value on
         purpose — they exist as semantic aliases, never as divergent sizes. -->
    <System:Double x:Key="PrimaryButtonHeight">32</System:Double>
    <System:Double x:Key="PrimaryButtonMinWidth">100</System:Double>
    <System:Double x:Key="SecondaryButtonHeight">32</System:Double>
    <System:Double x:Key="SecondaryButtonMinWidth">88</System:Double>
    <System:Double x:Key="ButtonMinWidth">88</System:Double>
    <System:Double x:Key="IconButtonSize">32</System:Double>
    <System:Double x:Key="AppTextInputHeight">32</System:Double>
    <System:Double x:Key="AppComboBoxHeight">32</System:Double>

    <!-- FORM PROPORTIONS (Phenix layout rule): every form is ONE shared column
         grid — a fixed label column beside each field column, field columns
         star-sized so field edges align vertically across all rows and a row
         with fewer fields subdivides the same total width by column spans
         (full / half / third / quarter). FormLabelWidth is the one label
         column width for a window's forms. The FieldWidth* classes are ONLY
         for the rare non-grid contexts (filter bars, search boxes); inside a
         form grid, fields stretch to their column and carry no width. -->
    <System:Double x:Key="FormLabelWidth">120</System:Double>
    <GridLength x:Key="FormLabelColumnWidth">120</GridLength>
    <!-- GridLength twin of PrimaryButtonMinWidth (100): ColumnDefinition.Width
         requires a GridLength value; referencing the Double token there compiles
         but throws at runtime when the window loads. Keep the two in sync. -->
    <GridLength x:Key="PrimaryButtonColumnWidth">100</GridLength>
    <System:Double x:Key="FieldWidthTiny">80</System:Double>
    <System:Double x:Key="FieldWidthShort">120</System:Double>
    <System:Double x:Key="FieldWidthMedium">180</System:Double>
    <System:Double x:Key="FieldWidthLong">240</System:Double>
    <System:Double x:Key="FieldWidthWide">400</System:Double>
    <System:Double x:Key="MultilineFieldHeight">64</System:Double>
    <Thickness x:Key="MarginFormLabel">0,0,8,8</Thickness>
    <Thickness x:Key="MarginFormField">0,0,12,8</Thickness>
    <System:Double x:Key="WindowChromeButtonHeight">34</System:Double>
    <System:Double x:Key="WindowChromeButtonFontSize">14</System:Double>
    <System:Double x:Key="IconButtonFontSize">14</System:Double>
    <System:Double x:Key="TableHeaderHeight">34</System:Double>
    <System:Double x:Key="TableRowHeight">30</System:Double>
    <System:Double x:Key="TableFontSize">12</System:Double>
    <System:Double x:Key="CompactFontSize">12</System:Double>
    <System:Double x:Key="WindowChromeFontSize">12</System:Double>
    <FontFamily x:Key="ShellChromeFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="WindowChromeSymbolFontFamily">Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">Consolas</FontFamily>

    <!-- Shared, deliberately restrained elevation effects. -->
    <DropShadowEffect
        x:Key="VisuSoftShadow"
        Color="#000000"
        BlurRadius="8"
        ShadowDepth="2"
        Opacity="0.12"/>

    <DropShadowEffect
        x:Key="VisuTextShadow"
        Color="#000000"
        BlurRadius="1.5"
        ShadowDepth="0.5"
        Opacity="0.10"/>


    <!-- =========================================================
         WINDOW CHROME DIMENSIONS
         ========================================================= -->

    <!-- These are Double because the target properties require Double. -->
    <System:Double x:Key="ChromeHeight">32</System:Double>
    <System:Double x:Key="ChromeButtonWidth">46</System:Double>

    <!-- These are GridLength because Grid definitions require GridLength. -->
    <GridLength x:Key="ChromeRowHeight">32</GridLength>
    <GridLength x:Key="ChromeButtonColumnWidth">46</GridLength>

    <Thickness x:Key="ChromeResizeBorderThickness">6</Thickness>
    <CornerRadius x:Key="ChromeCornerRadius">8</CornerRadius>


    <!-- =========================================================
         WINDOW CHROME COLORS
         ========================================================= -->

    <SolidColorBrush
        x:Key="ChromeBackgroundBrush"
        Color="{StaticResource Neutral100Color}"/>

    <SolidColorBrush
        x:Key="ChromeForegroundBrush"
        Color="{StaticResource Neutral900Color}"/>

    <SolidColorBrush
        x:Key="ChromeBorderBrush"
        Color="#D5D9DE"/>

    <SolidColorBrush
        x:Key="ChromeButtonHoverBrush"
        Color="#E8EAED"/>

    <SolidColorBrush
        x:Key="ChromeButtonPressedBrush"
        Color="#D5D9DE"/>

    <SolidColorBrush
        x:Key="ChromeCloseHoverBrush"
        Color="#C42B1C"/>

    <SolidColorBrush
        x:Key="ChromeClosePressedBrush"
        Color="#8F1F16"/>

    <SolidColorBrush
        x:Key="ChromeCloseForegroundBrush"
        Color="#FFFFFF"/>


    <!-- =========================================================
         APPLICATION SURFACES
         ========================================================= -->

    <SolidColorBrush
        x:Key="BackgroundBrush"
        Color="{StaticResource Neutral100Color}"/>

    <SolidColorBrush
        x:Key="SurfaceBrush"
        Color="{StaticResource NeutralWhiteColor}"/>

    <SolidColorBrush
        x:Key="SurfaceSecondaryBrush"
        Color="{StaticResource Neutral200Color}"/>

    <SolidColorBrush
        x:Key="SurfaceDarkBrush"
        Color="#263238"/>

    <SolidColorBrush
        x:Key="TextOnDarkBrush"
        Color="#FFFFFF"/>

    <SolidColorBrush
        x:Key="FieldBackgroundBrush"
        Color="{StaticResource NeutralWhiteColor}"/>

    <SolidColorBrush
        x:Key="FieldReadOnlyBrush"
        Color="{StaticResource Neutral150Color}"/>


    <!-- =========================================================
         TEXT AND BORDERS
         ========================================================= -->

    <SolidColorBrush
        x:Key="TextPrimary"
        Color="{StaticResource Neutral900Color}"/>

    <SolidColorBrush
        x:Key="TextSecondary"
        Color="{StaticResource Neutral600Color}"/>

    <SolidColorBrush
        x:Key="TextDisabled"
        Color="{StaticResource Neutral500Color}"/>

    <SolidColorBrush
        x:Key="BorderBrush"
        Color="{StaticResource Neutral300Color}"/>

    <SolidColorBrush
        x:Key="BorderStrongBrush"
        Color="{StaticResource Neutral400Color}"/>

    <SolidColorBrush
        x:Key="DividerBrush"
        Color="{StaticResource Neutral250Color}"/>


    <!-- =========================================================
         ACCENT COLORS
         ========================================================= -->

    <SolidColorBrush
        x:Key="AccentPrimary"
        Color="{StaticResource AccentPrimaryColor}"/>

    <SolidColorBrush
        x:Key="AccentDark"
        Color="{StaticResource AccentDarkColor}"/>

    <SolidColorBrush
        x:Key="AccentLight"
        Color="{StaticResource AccentLightColor}"/>

    <SolidColorBrush
        x:Key="AccentHover"
        Color="{StaticResource AccentHoverColor}"/>

    <SolidColorBrush
        x:Key="AccentOnPrimaryBrush"
        Color="#FFFFFF"/>


    <!-- =========================================================
         SEMANTIC COLORS
         ========================================================= -->

    <SolidColorBrush
        x:Key="SuccessBrush"
        Color="{StaticResource SuccessColor}"/>

    <SolidColorBrush
        x:Key="WarningBrush"
        Color="{StaticResource WarningColor}"/>

    <SolidColorBrush
        x:Key="ErrorBrush"
        Color="{StaticResource ErrorColor}"/>

    <SolidColorBrush
        x:Key="InfoBrush"
        Color="{StaticResource InfoColor}"/>

    <SolidColorBrush
        x:Key="SuccessDarkBrush"
        Color="{StaticResource SuccessDarkColor}"/>

    <SolidColorBrush
        x:Key="ErrorDarkBrush"
        Color="{StaticResource ErrorDarkColor}"/>
    <SolidColorBrush x:Key="TextOnErrorBrush" Color="#FFD0D0"/>
    <SolidColorBrush x:Key="TextMutedOnDarkBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="TextOnDarkMutedBrush" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="TextOnDarkSecondaryBrush" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#80000000"/>
    <SolidColorBrush x:Key="ReportDesignerButtonBrush" Color="#2D4A6B"/>

    <SolidColorBrush x:Key="PosInkBrush" Color="#172B3A"/>
    <SolidColorBrush x:Key="PosMutedBrush" Color="#687985"/>
    <SolidColorBrush x:Key="PosTealBrush" Color="#087F8C"/>
    <SolidColorBrush x:Key="PosCanvasBrush" Color="#F3F6F8"/>
    <SolidColorBrush x:Key="PosBorderBrush" Color="#DCE5EA"/>
    <SolidColorBrush x:Key="PosRemoveBackgroundBrush" Color="#EEF3F5"/>
    <SolidColorBrush x:Key="PosTotalLabelBrush" Color="#B9D4DC"/>
    <SolidColorBrush x:Key="PosClearBackgroundBrush" Color="#FFF0F0"/>
    <SolidColorBrush x:Key="PosClearForegroundBrush" Color="#A33232"/>
    <SolidColorBrush x:Key="PosButtonBackgroundBrush" Color="#F4F7F8"/>
    <SolidColorBrush x:Key="PosTealDarkBrush" Color="#075E66"/>


    <!-- =========================================================
         DOCUMENT AND TABLE TINT BRUSHES
         Alternating zebra rows and custom header tints.
         ========================================================= -->

    <SolidColorBrush
        x:Key="TableAlternateRowBrush"
        Color="#F1F5F7"/>

    <SolidColorBrush
        x:Key="TableSurfaceBrush"
        Color="{StaticResource Neutral50Color}"/>

    <SolidColorBrush
        x:Key="TableHeaderBrush"
        Color="#556F7A"/>

    <SolidColorBrush
        x:Key="TableHeaderBorderBrush"
        Color="#D5D9DE"/>

    <SolidColorBrush
        x:Key="TableHoverBrush"
        Color="#E7EEF1"/>

    <SolidColorBrush
        x:Key="TableSelectedBrush"
        Color="#26F39A16"/>

    <SolidColorBrush
        x:Key="TableSelectedBorderBrush"
        Color="#F39A16"/>

    <!-- =========================================================
         SCHEDULE TINT PALETTE
         Per-window zebra tints: a window claims one tint by name
         (BaseWin.ScheduleTintName) and every schedule in that window
         alternates white (TableSurfaceBrush) with the tint. All tints
         are light Win11-harmonized pastels in the same lightness band
         as the default TableAlternateRowBrush (#F1F5F7), so body text
         keeps full contrast and the hover (#E7EEF1) and selection
         (translucent #F39A16 wash + solid border) states stay clearly
         visible on top of every tint.
         ========================================================= -->

    <SolidColorBrush x:Key="ScheduleTintBlueBrush" Color="#E9F1FC"/>
    <SolidColorBrush x:Key="ScheduleTintSkyBrush" Color="#E5F3FA"/>
    <SolidColorBrush x:Key="ScheduleTintAquaBrush" Color="#E1F5F7"/>
    <SolidColorBrush x:Key="ScheduleTintTealBrush" Color="#E3F4F1"/>
    <SolidColorBrush x:Key="ScheduleTintMintBrush" Color="#E6F6EC"/>
    <SolidColorBrush x:Key="ScheduleTintGreenBrush" Color="#EDF7E3"/>
    <SolidColorBrush x:Key="ScheduleTintAmberBrush" Color="#FBF2D9"/>
    <SolidColorBrush x:Key="ScheduleTintSandBrush" Color="#F6EEDD"/>
    <SolidColorBrush x:Key="ScheduleTintPeachBrush" Color="#FDEEDD"/>
    <SolidColorBrush x:Key="ScheduleTintRoseBrush" Color="#FBE9EA"/>
    <SolidColorBrush x:Key="ScheduleTintLavenderBrush" Color="#EEEAF9"/>
    <SolidColorBrush x:Key="ScheduleTintLilacBrush" Color="#F2E9FA"/>
    <SolidColorBrush x:Key="ScheduleTintPeriwinkleBrush" Color="#E8EBFA"/>
    <SolidColorBrush x:Key="ScheduleTintSlateBrush" Color="#EBEFF4"/>
    <SolidColorBrush x:Key="ScheduleTintStoneBrush" Color="#F2EFE9"/>
    <SolidColorBrush x:Key="ScheduleTintSilverBrush" Color="#EFF2F0"/>
    <!-- Step-13 extension: the original 16-token palette (Peach spare
         included) could not give every schedule-bearing window the
         audits named as tint-less a UNIQUE tint, so the palette grows
         in the same lightness band and pastel register. -->
    <SolidColorBrush x:Key="ScheduleTintCoralBrush" Color="#F9E3D8"/>
    <SolidColorBrush x:Key="ScheduleTintBlushBrush" Color="#F9E3EC"/>
    <SolidColorBrush x:Key="ScheduleTintPlumBrush" Color="#F3E2F2"/>
    <SolidColorBrush x:Key="ScheduleTintVioletBrush" Color="#E3DCF7"/>
    <SolidColorBrush x:Key="ScheduleTintIndigoBrush" Color="#DCE4F9"/>
    <SolidColorBrush x:Key="ScheduleTintDenimBrush" Color="#DEEBF5"/>
    <SolidColorBrush x:Key="ScheduleTintCyanBrush" Color="#D8EFEF"/>
    <SolidColorBrush x:Key="ScheduleTintJadeBrush" Color="#DFF2E4"/>
    <SolidColorBrush x:Key="ScheduleTintFernBrush" Color="#E4F0DC"/>
    <SolidColorBrush x:Key="ScheduleTintSageBrush" Color="#E6F0E2"/>
    <SolidColorBrush x:Key="ScheduleTintLimeBrush" Color="#EDF5D8"/>
    <SolidColorBrush x:Key="ScheduleTintOliveBrush" Color="#F1F2DC"/>
    <SolidColorBrush x:Key="ScheduleTintHoneyBrush" Color="#F8EDCB"/>
    <SolidColorBrush x:Key="ScheduleTintBronzeBrush" Color="#EFE3D3"/>
    <SolidColorBrush x:Key="ScheduleTintMauveBrush" Color="#F2E4EA"/>
    <SolidColorBrush x:Key="ScheduleTintWheatBrush" Color="#F7EFDB"/>
    <SolidColorBrush x:Key="ScheduleTintLagoonBrush" Color="#DDEEEA"/>
    <SolidColorBrush x:Key="ScheduleTintOrchidBrush" Color="#F0E4F5"/>
    <SolidColorBrush x:Key="ScheduleTintPeridotBrush" Color="#EAF2D2"/>
