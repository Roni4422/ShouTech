    <!-- =========================================================
         WINDOW CLOSE BUTTON
         ========================================================= -->

    <Style
		x:Key="VisuChromeCloseButtonStyle"
		TargetType="{x:Type Button}"
		BasedOn="{StaticResource VisuChromeButtonStyle}">

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Button}">
					<Border x:Name="ChromeCloseBorder"
							Background="{TemplateBinding Background}"
							BorderThickness="0"
							SnapsToDevicePixels="True">
						<ContentPresenter HorizontalAlignment="Center"
										  VerticalAlignment="Center"
										  TextElement.Foreground="{TemplateBinding Foreground}"/>
					</Border>
					<ControlTemplate.Triggers>
						
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="ChromeCloseBorder" Property="Background" Value="{DynamicResource ChromeCloseHoverBrush}"/>
							<Setter Property="Foreground" Value="{DynamicResource ChromeCloseForegroundBrush}"/>
						</Trigger>
						
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="ChromeCloseBorder" Property="Background" Value="{DynamicResource ChromeClosePressedBrush}"/>
							<Setter Property="Foreground" Value="{DynamicResource ChromeCloseForegroundBrush}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
