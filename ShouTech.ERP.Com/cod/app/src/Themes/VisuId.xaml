    <!-- =========================================================
         CENTRAL WINDOW
         ========================================================= -->

    <Style
        x:Key="VisuWindowStyle"
        TargetType="{x:Type Window}">

        <Setter
            Property="WindowStyle"
            Value="None"/>

        <Setter
            Property="ResizeMode"
            Value="CanResize"/>

        <Setter
            Property="Background"
            Value="{DynamicResource BackgroundBrush}"/>

        <Setter
            Property="Foreground"
            Value="{DynamicResource TextPrimary}"/>

        <Setter
            Property="FontFamily"
            Value="{DynamicResource ApplicationFontFamily}"/>

        <Setter
            Property="FontSize"
            Value="{DynamicResource ApplicationFontSize}"/>

        <Setter
            Property="UseLayoutRounding"
            Value="True"/>

        <Setter
            Property="SnapsToDevicePixels"
            Value="True"/>


        <!-- Window chrome configuration -->
        <Setter
            Property="shell:WindowChrome.WindowChrome">

            <Setter.Value>

                <shell:WindowChrome
                    CaptionHeight="{DynamicResource ChromeHeight}"
                    ResizeBorderThickness="{DynamicResource ChromeResizeBorderThickness}"
                    CornerRadius="{DynamicResource ChromeCornerRadius}"
                    GlassFrameThickness="0"
                    UseAeroCaptionButtons="False"/>

            </Setter.Value>

        </Setter>


        <!-- Central window template -->
        <Setter
            Property="Template">

            <Setter.Value>

                <ControlTemplate
                    TargetType="{x:Type Window}">

                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource ChromeBorderBrush}"
                        BorderThickness="1">

                        <Grid>

                            <Grid.RowDefinitions>

                                <!-- GridLength resource, not Double -->
                                <RowDefinition
                                    Height="{DynamicResource ChromeRowHeight}"/>

                                <RowDefinition
                                    Height="*"/>

                            </Grid.RowDefinitions>


                            <!-- Title bar -->

                            <Border
                                Grid.Row="0"
                                Background="{DynamicResource ChromeBackgroundBrush}"
                                BorderBrush="{DynamicResource ChromeBorderBrush}"
                                BorderThickness="0,0,0,1">

                                <Grid
                                    FlowDirection="{Binding FlowDirection, RelativeSource={RelativeSource TemplatedParent}}">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition
                                            Width="*"/>

                                        <!-- GridLength resources -->
                                        <ColumnDefinition
                                            Width="{DynamicResource ChromeButtonColumnWidth}"/>

                                        <ColumnDefinition
                                            Width="{DynamicResource ChromeButtonColumnWidth}"/>

                                        <ColumnDefinition
                                            Width="{DynamicResource ChromeButtonColumnWidth}"/>

                                    </Grid.ColumnDefinitions>


                                    <!-- Window title -->

                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="14,0,8,0"
                                        VerticalAlignment="Center"
                                        Text="{TemplateBinding Title}"
                                        Style="{DynamicResource VisuChromeTitleStyle}"/>


                                    <!-- Minimize -->

                                    <Button
                                        Grid.Column="1"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                        Command="{x:Static wpf:SystemCommands.MinimizeWindowCommand}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                        Style="{DynamicResource VisuChromeButtonStyle}"
                                        ToolTip="Minimize">

                                        <TextBlock
                                            Text="&#x2500;"
                                            FontFamily="{DynamicResource WindowChromeSymbolFontFamily}"
                                            FontSize="{DynamicResource FontSize15}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Button>


                                    <!-- Maximize -->

                                    <Grid
                                        Grid.Column="2">

                                        <Button
                                            x:Name="MaximizeButton"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                            Command="{x:Static wpf:SystemCommands.MaximizeWindowCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                            Style="{DynamicResource VisuChromeButtonStyle}"
                                            ToolTip="Maximize">

                                            <TextBlock
                                                Text="&#x25A1;"
                                                FontFamily="{DynamicResource WindowChromeSymbolFontFamily}"
                                                FontSize="{DynamicResource FontSize13}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </Button>


                                        <!-- Restore -->

                                        <Button
                                            x:Name="RestoreButton"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                            Command="{x:Static wpf:SystemCommands.RestoreWindowCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                            Style="{DynamicResource VisuChromeButtonStyle}"
                                            ToolTip="Restore"
                                            Visibility="Collapsed">

                                            <TextBlock
                                                Text="&#x2750;"
                                                FontFamily="{DynamicResource WindowChromeSymbolFontFamily}"
                                                FontSize="{DynamicResource FontSize13}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        </Button>

                                    </Grid>


                                    <!-- Close -->

                                    <Button
                                        Grid.Column="3"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                        Command="{x:Static wpf:SystemCommands.CloseWindowCommand}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                        Style="{DynamicResource VisuChromeCloseButtonStyle}"
                                        ToolTip="Close">

                                        <TextBlock
                                            Text="&#x00D7;"
                                            FontFamily="{DynamicResource WindowChromeSymbolFontFamily}"
                                            FontSize="{DynamicResource FontSize18}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Button>

                                </Grid>

                            </Border>


                            <!-- Window content -->

                            <AdornerDecorator
                                Grid.Row="1">

                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                    Margin="0"/>

                            </AdornerDecorator>

                        </Grid>

                    </Border>


                    <!-- Window state -->

                    <ControlTemplate.Triggers>

                        <Trigger
                            Property="WindowState"
                            Value="Maximized">

                            <Setter
                                TargetName="MaximizeButton"
                                Property="Visibility"
                                Value="Collapsed"/>

                            <Setter
                                TargetName="RestoreButton"
                                Property="Visibility"
                                Value="Visible"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>


    <!-- =========================================================
         GLOBAL CONTROL COVERAGE (2026 design system)
         Complete keyed styles live here; the implicit styles in
         the Fluent layer below and in App.xaml are BasedOn them,
         so every window - XAML or code-built - gets the same
         templates. Templates use semantic tokens only: no literal
         colors, and state changes never mutate shared brushes
         (hover is an overlay wash whose opacity animates with the
         motion tokens).
         ========================================================= -->

    <!-- TOGGLEBUTTON (keyed): segmented-control look; checked is
         an accent wash + accent border, never opacity-only. -->
    <Style x:Key="Win11ToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="FontFamily" Value="{DynamicResource ApplicationFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource ApplicationFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="{DynamicResource ControlHeight}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Win11FocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="ToggleBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource ButtonCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="HoverWash"
                                    Background="{DynamicResource SurfaceHoverBrush}"
                                    CornerRadius="{DynamicResource ButtonCornerRadius}"
                                    Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverWash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.7"
                                                         Duration="{StaticResource MotionDurationFast}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverWash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="{StaticResource MotionDurationFast}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ============ DATEPICKER + CALENDAR FAMILY ============ -->

    <Style x:Key="Win11CalendarDayButtonStyle" TargetType="{x:Type CalendarDayButton}">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{DynamicResource ApplicationFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize12}"/>
        <Setter Property="MinWidth" Value="28"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                    <Border x:Name="DayBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource RadiusSmall}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                            <Setter TargetName="DayBorder" Property="BorderThickness" Value="1"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource AccentPrimary}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentOnPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                            <Setter TargetName="DayBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
