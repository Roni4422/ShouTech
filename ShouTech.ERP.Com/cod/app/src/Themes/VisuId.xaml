    <!-- =========================================================
         TEXT STYLES
         ========================================================= -->

    <Style
        x:Key="VisuTextStyle"
        TargetType="{x:Type TextBlock}">

        <Setter
            Property="FontFamily"
            Value="{DynamicResource ApplicationFontFamily}"/>

        <Setter
            Property="FontSize"
            Value="{DynamicResource ApplicationFontSize}"/>

        <Setter
            Property="Foreground"
            Value="{DynamicResource TextPrimary}"/>

        <Setter
            Property="VerticalAlignment"
            Value="Center"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="RightToLeft">
                <Setter Property="TextAlignment" Value="Right"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="LeftToRight">
                <Setter Property="TextAlignment" Value="Left"/>
            </DataTrigger>
        </Style.Triggers>

    </Style>


    <Style
        x:Key="VisuTextSecondaryStyle"
        TargetType="{x:Type TextBlock}"
        BasedOn="{StaticResource VisuTextStyle}">

        <Setter
            Property="Foreground"
            Value="{DynamicResource TextSecondary}"/>

        <Setter
            Property="Effect"
            Value="{x:Null}"/>

    </Style>


    <Style
        x:Key="VisuCaptionStyle"
        TargetType="{x:Type TextBlock}"
        BasedOn="{StaticResource VisuTextStyle}">

        <Setter
            Property="FontSize"
            Value="{DynamicResource FontSize12}"/>

        <Setter
            Property="Foreground"
            Value="{DynamicResource TextSecondary}"/>

    </Style>


    <Style
        x:Key="VisuTitleStyle"
        TargetType="{x:Type TextBlock}"
        BasedOn="{StaticResource VisuTextStyle}">

        <Setter
            Property="FontFamily"
            Value="{DynamicResource ApplicationFontFamilyStrong}"/>

        <Setter
            Property="FontSize"
            Value="{DynamicResource FontSize20}"/>

        <Setter
            Property="FontWeight"
            Value="SemiBold"/>

        <Setter
            Property="Effect"
            Value="{StaticResource VisuTextShadow}"/>

    </Style>


    <Style
        x:Key="VisuSectionTitleStyle"
        TargetType="{x:Type TextBlock}"
        BasedOn="{StaticResource VisuTextStyle}">

        <Setter
            Property="FontFamily"
            Value="{DynamicResource ApplicationFontFamilyStrong}"/>

        <Setter
            Property="FontSize"
            Value="{DynamicResource FontSize15}"/>

        <Setter
            Property="FontWeight"
            Value="SemiBold"/>

        <Setter
            Property="Margin"
            Value="0,8,0,8"/>

        <Setter
            Property="Effect"
            Value="{StaticResource VisuTextShadow}"/>

    </Style>


    <!-- =========================================================
         LABEL STYLES
         Label and TextBlock are intentionally separate controls.
         ========================================================= -->

    <Style
        x:Key="VisuLabelStyle"
        TargetType="{x:Type Label}">

        <Setter
            Property="FontFamily"
            Value="{DynamicResource ApplicationFontFamily}"/>

        <Setter
            Property="FontSize"
            Value="{DynamicResource ApplicationFontSize}"/>

        <Setter
            Property="Foreground"
            Value="{DynamicResource TextPrimary}"/>

        <Setter
            Property="VerticalContentAlignment"
            Value="Center"/>

        <Setter
            Property="Padding"
            Value="0,0,4,0"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="RightToLeft">
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="LeftToRight">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </DataTrigger>
        </Style.Triggers>

    </Style>


    <Style
        x:Key="VisuTextBlockLabelStyle"
        TargetType="{x:Type TextBlock}">

        <Setter
            Property="FontFamily"
            Value="{DynamicResource ApplicationFontFamily}"/>

        <Setter
            Property="FontSize"
            Value="{DynamicResource ApplicationFontSize}"/>

        <Setter
            Property="Foreground"
            Value="{DynamicResource TextPrimary}"/>

        <Setter
            Property="VerticalAlignment"
            Value="Center"/>

    </Style>


    <!-- =========================================================
         TEXTBOX
         ========================================================= -->

    <Style
        x:Key="VisuTextBoxStyle"
        TargetType="{x:Type TextBox}">

        <Setter
            Property="Height"
            Value="{DynamicResource ControlHeight}"/>

        <Setter
            Property="Padding"
            Value="9,0"/>

        <Setter
            Property="TextAlignment"
            Value="Left"/>

        <Setter
            Property="FontFamily"
            Value="{DynamicResource ApplicationFontFamily}"/>

        <Setter
            Property="FontSize"
            Value="{DynamicResource ApplicationFontSize}"/>

        <Setter
            Property="Foreground"
            Value="{DynamicResource TextPrimary}"/>

        <Setter
            Property="Background"
            Value="{DynamicResource FieldBackgroundBrush}"/>

        <Setter
            Property="Effect"
            Value="{StaticResource VisuSoftShadow}"/>

        <Setter
            Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border
                        x:Name="FieldBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        SnapsToDevicePixels="True">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                            <Setter TargetName="FieldBorder" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="FieldBorder" Property="Background" Value="{DynamicResource FieldReadOnlyBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="FieldBorder" Property="Opacity" Value="0.65"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter
            Property="BorderBrush"
            Value="{DynamicResource BorderBrush}"/>

        <Setter
            Property="BorderThickness"
            Value="1"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="RightToLeft">
                <Setter Property="TextAlignment" Value="Right"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding FlowDirection, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="LeftToRight">
                <Setter Property="TextAlignment" Value="Left"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>


